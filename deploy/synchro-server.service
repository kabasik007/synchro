[Unit]
Description=Synchro Internet Mode Rust relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=synchro
Group=synchro
WorkingDirectory=/opt/synchro
EnvironmentFile=/etc/synchro/synchro.env
ExecStart=/opt/synchro/bin/synchro-server
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/synchro
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
