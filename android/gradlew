#!/bin/sh
# Synchro Gradle 8.13 launcher. Retrieves the published Wrapper JAR once and verifies SHA-256.
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
EXPECTED=81a82aaea5abcc8ff68b3dfcb58b3c3c429378efd98e7433460610fecd7ae45f
verify() {
    if command -v sha256sum >/dev/null 2>&1; then
        actual=$(sha256sum "$1" | cut -d ' ' -f 1)
    elif command -v shasum >/dev/null 2>&1; then
        actual=$(shasum -a 256 "$1" | cut -d ' ' -f 1)
    else
        echo "A SHA-256 checksum tool is required (sha256sum or shasum)." >&2
        return 1
    fi
    [ "$actual" = "$EXPECTED" ] || { echo "Wrapper JAR SHA-256 mismatch: $actual" >&2; return 1; }
}
if [ ! -f "$JAR" ]; then
    mkdir -p "$APP_HOME/gradle/wrapper"
    tmp="$JAR.$$"
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    url=https://services.gradle.org/distributions/gradle-8.13-wrapper.jar
    if command -v curl >/dev/null 2>&1; then
        curl --fail --location --silent --show-error --proto '=https' "$url" -o "$tmp"
    elif command -v wget >/dev/null 2>&1; then
        wget -q "$url" -O "$tmp"
    else
        echo "curl or wget is required to bootstrap Gradle Wrapper." >&2
        exit 1
    fi
    verify "$tmp"
    mv "$tmp" "$JAR"
    trap - EXIT HUP INT TERM
fi
verify "$JAR"
if [ -n "${JAVA_HOME:-}" ]; then
    JAVA="$JAVA_HOME/bin/java"
else
    JAVA=java
fi
exec "$JAVA" -Xms64m -Xmx64m -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
